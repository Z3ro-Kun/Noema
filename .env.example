# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Postgres (used by docker-compose and by the backend's DATABASE_URL below)
POSTGRES_USER=noema
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=noema
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
# Exactly `development` or `production`; anything else is refused at startup,
# because every production guard hangs off this one value. `production` turns
# every development default below into a startup error -- see
# Settings.verify_production. Leave it as `development` locally.
ENVIRONMENT=development

# Browser origins allowed to call the API, comma-separated. The API is called
# with credentials, so this can never be `*`. In production it must be the
# deployed frontend's own https origin.
CORS_ORIGINS=http://localhost:5173

# Full connection strings, used when running the backend outside docker-compose
# (e.g. `uvicorn app.main:app` on your host against `docker compose up db redis`).
# Each must name its driver: the app needs asyncpg, Alembic needs psycopg2 (or
# psycopg). A provider's driverless `postgresql://...` is refused in production.
DATABASE_URL=postgresql+asyncpg://noema:replace-with-local-password@localhost:5432/noema
SYNC_DATABASE_URL=postgresql+psycopg2://noema:replace-with-local-password@localhost:5432/noema
REDIS_URL=redis://localhost:6379/0
