# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Postgres (used by docker-compose and by the backend's DATABASE_URL below)
POSTGRES_USER=noema
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=noema
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
ENVIRONMENT=development

# Full connection strings, used when running the backend outside docker-compose
# (e.g. `uvicorn app.main:app` on your host against `docker compose up db redis`).
DATABASE_URL=postgresql+asyncpg://noema:replace-with-local-password@localhost:5432/noema
SYNC_DATABASE_URL=postgresql+psycopg2://noema:replace-with-local-password@localhost:5432/noema
REDIS_URL=redis://localhost:6379/0
