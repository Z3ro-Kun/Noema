# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Exactly `development` or `production`; anything else is refused at startup.
# `production` makes the development defaults below fatal at startup.
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API. Never `*`: the API
# is called with credentials. In production, the deployed frontend's origin.
CORS_ORIGINS=http://localhost:5173
# Both URLs must name their driver. A managed Postgres dashboard hands out a
# driverless `postgresql://user:pass@host/db`, which is wrong in both: the app
# needs asyncpg and Alembic needs psycopg2 (or psycopg). Production refuses a
# value that does not say which.
DATABASE_URL=postgresql+asyncpg://noema:replace-with-local-password@localhost:5432/noema
SYNC_DATABASE_URL=postgresql+psycopg2://noema:replace-with-local-password@localhost:5432/noema
REDIS_URL=redis://localhost:6379/0
